import * as THREE from 'three';

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera( 75, window.innerWidth / window.innerHeight, 0.1, 1000 );

const renderer = new THREE.WebGLRenderer();
renderer.setSize( window.innerWidth, window.innerHeight );
document.body.appendChild( renderer.domElement );

const texture = new THREE.TextureLoader().load();
const geometry = new THREE.BoxGeometry( 2, 3, 0.05 );
const material = new THREE.MeshBasicMaterial( { color: 0x00ff00 } );
const cube = new THREE.Mesh( geometry, material );
scene.add( cube );

cube.position.set(0, 0, 0);

camera.position.z = 4;

let mouseOffset = undefined;
document.body.ondragstart = () => { return false };

document.body.onmousedown = (event) => {
	console.log('onmousedown');
	mouseOffset = {
  	x: event.offsetX, 
    y: event.offserY  
  };
}

document.body.onmouseup = (event) => {
	console.log('onmouseup');
	mouseOffset = undefined;
}

document.body.onmousemove = (event) => {
	if (!mouseOffset) return;
	console.log('onmousemove', event.offsetX, mouseOffset.x);  
  cube.rotation.y += (event.offsetX > mouseOffset.x) ? 0.1 : -0.1;
}

function animate() {
	requestAnimationFrame( animate );
	renderer.render( scene, camera );
}

animate();
